# PostgreSQL
POSTGRES_USER=promptguard
POSTGRES_PASSWORD=promptguard
POSTGRES_DB=promptguard
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Service ports
PROMPT_MANAGER_PORT=8000
LLM_GATEWAY_PORT=8002
ANALYTICS_PORT=8003

# CORS (for prompt-manager)
CORS_ORIGINS=["http://localhost:3000"]
API_KEY=
MASTER_KEY=
BILLING_URL=http://localhost:8000/api/v1/billing/usage
BILLING_API_KEY=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGS=RS256
INTERNAL_API_KEY=
AUTO_CREATE_TABLES=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=
AUDIT_URL=
AUDIT_API_KEY=
INTERNAL_CA_BUNDLE=
INTERNAL_CLIENT_CERT=
INTERNAL_CLIENT_KEY=
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1
RETRY_BACKOFF_MAX_SECONDS=30
LLM_TIMEOUT_SECONDS=60
ANALYTICS_TIMEOUT_SECONDS=10

# LLM API Keys (required for validation-engine and llm-gateway)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Add other providers as needed: AZURE_OPENAI_KEY, COHERE_API_KEY, etc.

# Optional: if you want to use a different Redis DB or password
# REDIS_PASSWORD=
